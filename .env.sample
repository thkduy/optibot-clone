GEMINI_API_KEY=
GEMINI_FILE_SEARCH_STORE=
ZENDESK_BASE_URL=https://support.optisigns.com
ARTICLE_LOCALE=en-us
MIN_ARTICLES=30
# Optional: cap pagination when intentionally testing a small collection.
ARTICLE_LIMIT=50
OUTPUT_DIR=data/articles
STATE_PATH=state/manifest.json
LAST_RUN_PATH=state/last-run.json
STATE_BACKEND=github_gist
LOG_LEVEL=INFO
POLL_SECONDS=5
MAX_WAIT_SECONDS=1200

# Use a Gist you control and a token with Gist read/write permission.
GITHUB_TOKEN=
GITHUB_GIST_ID=
GITHUB_GIST_MANIFEST_FILE=manifest.json
GITHUB_GIST_LAST_RUN_FILE=last-run.json
